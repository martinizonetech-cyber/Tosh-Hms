APP_NAME="Tosh Clinic HMS API"
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=4000
API_V1_PREFIX=/api/v1

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tosh_db

DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@localhost:5432/tosh_db

JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

RECEPTION_INITIAL_PASSWORD=Reception_Pass123!
SKIN_INITIAL_PASSWORD=SkinDoctor_Pass123!
ORTHO_INITIAL_PASSWORD=OrthoDoctor_Pass123!

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=tosh-documents
S3_REGION_NAME=us-east-1

TIMEZONE=Asia/Kolkata
